    },
    {
      "id": "reset-done",
      "batch": "batch-1",
      "page": "reset-password",
      "title": "Reset password — success",
      "route": "/reset-password?token=audit-reset-token",
      "actions": [
        {
          "fill": [
            "input[type=\"password\"] >> nth=0",
            "Bid-audit-2026"
          ]
        },
        {
          "fill": [
            "input[type=\"password\"] >> nth=1",
            "Bid-audit-2026"
          ]
        },
        {
          "click": "button[type=\"submit\"]"
        },
        {
          "wait": 800
        }
      ]
    },
    {
      "id": "verify-default",
      "batch": "batch-1",
      "page": "verify-email",
      "title": "Email code — first look",
      "route": "/verify-email",
      "persona": "unverified"
    },
    {
      "id": "verify-typing",
      "batch": "batch-1",
      "page": "verify-email",
      "title": "Email code — half typed",
      "route": "/verify-email",
      "persona": "unverified",
      "actions": [
        {
          "click": "input[inputmode=\"numeric\"] >> nth=0"
        },
        {
          "type": "123"
        },
        {
          "wait": 200
        }
      ]
    },
    {
      "id": "verify-wrong-code",
      "batch": "batch-1",
      "page": "verify-email",
      "title": "Email code — wrong code",
      "route": "/verify-email",
      "persona": "unverified",
      "overrides": {
        "POST /api/auth/verify-otp": {
          "status": 400,
          "json": {
            "message": "Invalid verification code"
          }
        }
      },
      "actions": [
        {
          "click": "input[inputmode=\"numeric\"] >> nth=0"
        },
        {
          "type": "123456"
        },
        {
          "wait": 1000
        }
      ]
    },
    {
      "id": "verify-change-email",
      "batch": "batch-1",
      "page": "verify-email",
      "title": "Email code — change email popup",
      "route": "/verify-email",
      "persona": "unverified",
      "expectDialog": true,
      "actions": [
        {
          "click": "[data-testid=\"button-change-email\"]"
        },
        {
          "waitFor": "[data-testid=\"input-new-email\"]"
        }
      ]
    },
    {
      "id": "verify-too-many",
      "batch": "batch-1",
      "page": "verify-email",
      "title": "Email code — too many code requests",
      "route": "/verify-email",
      "persona": "unverified",
      "overrides": {
        "POST /api/auth/send-otp": {
          "status": 429,
          "json": {
            "message": "Too many verification code requests. Please wait before trying again."
          }
        }
      },
      "actions": [
        {
          "wait": 1000
        }
      ]
    },
    {
      "id": "sso-callback-loading",
