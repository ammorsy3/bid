        {
          "click": "[data-testid=\"button-submit\"]"
        },
        {
          "wait": 400
        }
      ]
    },
    {
      "id": "signup-filled",
      "batch": "batch-1",
      "page": "signup",
      "title": "Sign up — long Arabic name, password shown with the eye button",
      "route": "/signup",
      "actions": [
        {
          "fill": [
            "[data-testid=\"input-name\"]",
            "عبدالرحمن بن عبدالعزيز بن سليمان الحربي"
          ]
        },
        {
          "fill": [
            "[data-testid=\"input-email\"]",
            "abdulrahman.alharbi@example.com"
          ]
        },
        {
          "fill": [
            "[data-testid=\"input-password\"]",
            "Bid-audit-2026"
          ]
        },
        {
          "click": "div.relative:has([data-testid=\"input-password\"]) button"
        },
        {
          "fill": [
            "[data-testid=\"input-confirm-password\"]",
            "Bid-audit-2026"
          ]
        },
        {
          "click": "div.relative:has([data-testid=\"input-confirm-password\"]) button"
        },
        {
          "click": "[data-testid=\"input-password\"]"
        },
        {
          "wait": 300
        }
      ]
    },
    {
      "id": "signup-email-taken",
      "batch": "batch-1",
      "page": "signup",
      "title": "Sign up — email already has an account",
      "route": "/signup",
      "overrides": {
        "POST /api/auth/register": {
          "status": 400,
          "json": {
            "message": "User already exists"
          }
        }
      },
      "actions": [
        {
          "fill": [
            "[data-testid=\"input-name\"]",
            "نورة عبدالله القحطاني"
          ]
        },
        {
          "fill": [
            "[data-testid=\"input-email\"]",
            "noura.alqahtani@example.com"
          ]
        },
        {
          "fill": [
            "[data-testid=\"input-password\"]",
            "Bid-audit-2026"
          ]
        },
        {
          "fill": [
            "[data-testid=\"input-confirm-password\"]",
            "Bid-audit-2026"
          ]
        },
        {
          "click": "[data-testid=\"button-submit\"]"
        },
        {
          "wait": 1000
        }
      ]
    },
    {
      "id": "reset-form",
      "batch": "batch-1",
      "page": "reset-password",
