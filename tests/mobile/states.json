{
  "_about": "One recipe per screen state for the mobile + Arabic audit. The capture spec photographs each state in every language and on every phone; the in-page helper (__mobileAudit.useState) loads the same recipe in the visible Chrome window. persona = a file in fixtures/. overrides = scripted API answers for this state (they win over fixtures). storage values of null remove the key.",
  "states": [
    {
      "id": "login-default",
      "batch": "batch-1",
      "page": "login",
      "title": "Login — first look",
      "route": "/login"
    },
    {
      "id": "login-empty-submit",
      "batch": "batch-1",
      "page": "login",
      "title": "Login — pressed Sign in with nothing typed",
      "route": "/login",
      "actions": [
        {
          "click": "[data-testid=\"button-submit\"]"
        },
        {
          "wait": 400
        }
      ]
    },
    {
      "id": "login-wrong-password",
      "batch": "batch-1",
      "page": "login",
      "title": "Login — wrong email or password",
      "route": "/login",
      "overrides": {
        "POST /api/auth/login": {
          "status": 401,
          "json": {
            "message": "Invalid credentials"
          }
        }
      },
      "actions": [
        {
          "fill": [
            "[data-testid=\"input-email\"]",
            "noura.alqahtani@example.com"
          ]
        },
        {
          "fill": [
            "[data-testid=\"input-password\"]",
            "wrong-password-1"
          ]
        },
        {
          "click": "[data-testid=\"button-submit\"]"
        },
        {
          "waitFor": "[data-testid=\"login-error\"]"
        }
      ]
    },
    {
      "id": "login-forgot",
      "batch": "batch-1",
      "page": "login",
      "title": "Login — forgot password form",
      "route": "/login",
      "actions": [
        {
          "click": "form button[type=\"button\"]:not([aria-label])"
        },
        {
          "wait": 300
        }
      ]
    },
    {
      "id": "login-forgot-sent",
      "batch": "batch-1",
      "page": "login",
      "title": "Login — reset link sent",
      "route": "/login",
      "actions": [
        {
          "click": "form button[type=\"button\"]:not([aria-label])"
        },
        {
          "fill": [
            "form input",
            "noura.alqahtani@example.com"
          ]
        },
        {
          "click": "form button[type=\"submit\"]"
        },
        {
          "wait": 800
        }
      ]
    },
    {
      "id": "login-expired-session",
      "batch": "batch-1",
      "page": "login",
      "title": "Login — phone still holds an expired session",
      "route": "/login",
      "persona": "expired",
      "actions": [
        {
          "wait": 3000
        }
      ]
    },
    {
      "id": "login-first-visit-arabic-phone",
      "batch": "batch-1",
      "page": "login",
      "title": "Login — first visit on an Arabic phone (nothing saved yet)",
      "route": "/login",
      "langs": [
        "en"
      ],
      "storage": {
        "language": null
      }
    },
    {
      "id": "login-instagram",
      "batch": "batch-1",
      "page": "login",
      "title": "Login — opened inside Instagram",
      "route": "/login",
      "projects": [
        "iphone-chrome",
        "iphone-webkit"
      ],
      "userAgent": "Mozilla/5.0 (iPhone; CPU iPhone OS 17_5 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148 Instagram 339.0.3.12.105 (iPhone15,3; iOS 17_5; ar_SA; ar; scale=3.00; 1290x2796; 625162385)"
    },
    {
      "id": "login-snapchat",
      "batch": "batch-1",
      "page": "login",
      "title": "Login — opened inside Snapchat",
